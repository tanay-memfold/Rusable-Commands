{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable command",
  "type": "object",
  "required": ["id", "app", "platform", "request", "params", "precondition", "steps", "verification"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"},
    "app": {
      "type": "object",
      "required": ["name", "bundle_id", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "bundle_id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "platform": {
      "type": "object",
      "required": ["os", "version"],
      "additionalProperties": false,
      "properties": {
        "os": {"const": "macOS"},
        "version": {"type": "string"}
      }
    },
    "request": {"type": "string"},
    "params": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "precondition": {
      "type": "object",
      "required": ["app_frontmost", "window_open"],
      "additionalProperties": false,
      "properties": {
        "app_frontmost": {"type": "string"},
        "window_open": {"type": "boolean"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["action", "control"],
            "additionalProperties": false,
            "properties": {"action": {"const": "press"}, "control": {"$ref": "#/$defs/control"}}
          },
          {
            "type": "object",
            "required": ["action", "control", "text"],
            "additionalProperties": false,
            "properties": {"action": {"const": "type"}, "control": {"$ref": "#/$defs/control"}, "text": {"type": "string"}}
          },
          {
            "type": "object",
            "required": ["action", "keys"],
            "additionalProperties": false,
            "properties": {"action": {"const": "key"}, "keys": {"type": "string"}}
          }
        ]
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "date", "runs", "engine"],
      "additionalProperties": false,
      "properties": {
        "status": {"const": "verified"},
        "date": {"type": "string", "format": "date"},
        "runs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["start_state", "run_id", "checks", "passed"],
            "additionalProperties": false,
            "properties": {
              "start_state": {"enum": ["learn", "app closed", "app open with an item"]},
              "run_id": {"type": "string"},
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["kind", "values"],
                  "additionalProperties": false,
                  "properties": {"kind": {"type": "string"}, "values": {"type": "array", "items": {"type": "string"}}}
                }
              },
              "passed": {"const": true}
            }
          }
        },
        "engine": {
          "type": "object",
          "required": ["name", "version", "commit"],
          "additionalProperties": false,
          "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "commit": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": ["role", "name"],
      "additionalProperties": false,
      "properties": {"role": {"type": "string"}, "name": {"type": "string"}}
    }
  }
}
