{
  "id": "reminders.create-list",
  "app": {
    "name": "Reminders",
    "bundle_id": "com.apple.reminders",
    "version": "7.0"
  },
  "platform": {
    "os": "macOS",
    "version": "26.6.2"
  },
  "request": "make a list {name} in Reminders",
  "params": [
    "name"
  ],
  "precondition": {
    "app_frontmost": "Reminders",
    "window_open": true
  },
  "steps": [
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "Add List"
      }
    },
    {
      "action": "type",
      "control": {
        "role": "TextField",
        "name": "Name:"
      },
      "text": "{name}"
    },
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "OK"
      }
    }
  ],
  "verification": {
    "status": "verified",
    "date": "2026-11-01",
    "runs": [
      {
        "start_state": "learn",
        "run_id": "2026-11-01-102851",
        "checks": [
          {
            "kind": "list",
            "values": [
              "Garden jobs"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app closed",
        "run_id": "2026-11-01-103032",
        "checks": [
          {
            "kind": "list",
            "values": [
              "Harbor Quartz"
            ]
          }
        ],
        "passed": true
      },
      {
