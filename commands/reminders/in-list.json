{
  "id": "reminders.add-reminder-to-list",
  "app": {
    "name": "Reminders",
    "bundle_id": "com.apple.reminders",
    "version": "7.0"
  },
  "platform": {
    "os": "macOS",
    "version": "26.6.2"
  },
  "request": "add a reminder {title} to the list {list} in Reminders",
  "params": [
    "title",
    "list"
  ],
  "precondition": {
    "app_frontmost": "Reminders",
    "window_open": true
  },
  "steps": [
    {
      "action": "press",
      "control": {
        "role": "Row",
        "name": "{list}…"
      }
    },
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "Add Reminder"
      }
    },
    {
      "action": "type",
      "control": {
        "role": "TextField",
        "name": "Incomplete"
      },
      "text": "{title}"
    },
    {
      "action": "key",
      "keys": "Return"
    }
  ],
  "verification": {
    "status": "verified",
    "date": "2026-11-01",
    "runs": [
      {
        "start_state": "learn",
        "run_id": "2026-11-01-103513",
        "checks": [
          {
            "kind": "in_list",
            "values": [
              "Buy compost",
              "Allotment"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app closed",
        "run_id": "2026-11-01-103644",
        "checks": [
          {
            "kind": "in_list",
            "values": [
              "Willow Ember",
              "Marble Harbor"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app open with an item",
        "run_id": "2026-11-01-103808",
        "checks": [
          {
            "kind": "in_list",
            "values": [
              "Quartz Willow",
              "River Tide"
            ]
          }
        ],
        "passed": true
      }
    ],
    "engine": {
      "name": "Voice Actions",
      "version": "3.9.4",
      "commit": "120ced22c"
    }
  }
}
