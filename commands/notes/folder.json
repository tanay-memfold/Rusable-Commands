{
  "id": "notes.create-folder",
  "app": {
    "name": "Notes",
    "bundle_id": "com.apple.Notes",
    "version": "4.13"
  },
  "platform": {
    "os": "macOS",
    "version": "26.6.2"
  },
  "request": "make a folder named {name} in Notes",
  "params": [
    "name"
  ],
  "precondition": {
    "app_frontmost": "Notes",
    "window_open": true
  },
  "steps": [
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "Add Folder"
      }
    },
    {
      "action": "type",
      "control": {
        "role": "TextField",
        "name": "Name:"
      },
      "text": "{name}"
    },
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "OK"
      }
    }
  ],
  "verification": {
    "status": "verified",
    "date": "2026-11-01",
    "runs": [
      {
        "start_state": "learn",
        "run_id": "2026-11-01-082034",
        "checks": [
          {
            "kind": "folder",
            "values": [
              "Errands"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app closed",
        "run_id": "2026-11-01-082159",
        "checks": [
          {
            "kind": "folder",
            "values": [
              "Willow River"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app open with an item",
        "run_id": "2026-11-01-082323",
        "checks": [
          {
            "kind": "folder",
            "values": [
              "Maple Marble"
            ]
          }
        ],
        "passed": true
      }
    ],
    "engine": {
      "name": "Voice Actions",
      "version": "3.9.3",
      "commit": "4918f84c9"
    }
  }
}
