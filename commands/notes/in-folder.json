{
  "id": "notes.create-note-in-folder",
  "app": {
    "name": "Notes",
    "bundle_id": "com.apple.Notes",
    "version": "4.13"
  },
  "platform": {
    "os": "macOS",
    "version": "26.6.2"
  },
  "request": "make a note titled {title} in the Notes folder {folder}",
  "params": [
    "title",
    "folder"
  ],
  "precondition": {
    "app_frontmost": "Notes",
    "window_open": true
  },
  "steps": [
    {
      "action": "press",
      "control": {
        "role": "Row",
        "name": "{folder}…"
      }
    },
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "New Note"
      }
    },
    {
      "action": "type",
      "control": {
        "role": "TextArea",
        "name": "note body text view"
      },
      "text": "{title}"
    }
  ],
  "verification": {
    "status": "verified",
    "date": "2026-11-01",
    "runs": [
      {
        "start_state": "learn",
        "run_id": "2026-11-01-082435",
        "checks": [
          {
            "kind": "in_folder",
            "values": [
              "Paint list",
              "Hobbies"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app closed",
        "run_id": "2026-11-01-082654",
        "checks": [
          {
            "kind": "in_folder",
            "values": [
              "Canyon Lantern",
              "Willow Lantern"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app open with an item",
        "run_id": "2026-11-01-082818",
        "checks": [
          {
            "kind": "in_folder",
            "values": [
              "Harbor Lantern",
              "Ember Glass"
            ]
          }
        ],
        "passed": true
      }
    ],
    "engine": {
      "name": "Voice Actions",
      "version": "3.9.3",
      "commit": "4918f84c9"
    }
  }
}
