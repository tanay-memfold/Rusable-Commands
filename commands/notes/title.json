{
  "id": "notes.create-note",
  "app": {
    "name": "Notes",
    "bundle_id": "com.apple.Notes",
    "version": "4.13"
  },
  "platform": {
    "os": "macOS",
    "version": "26.6.2"
  },
  "request": "make a note titled {title} in Notes",
  "params": [
    "title"
  ],
  "precondition": {
    "app_frontmost": "Notes",
    "window_open": true
  },
  "steps": [
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "New Note"
      }
    },
    {
      "action": "type",
      "control": {
        "role": "TextArea",
        "name": "note body text view"
      },
      "text": "{title}"
    }
  ],
  "verification": {
    "status": "verified",
    "date": "2026-11-01",
    "runs": [
      {
        "start_state": "learn",
        "run_id": "2026-11-01-081327",
        "checks": [
          {
            "kind": "note",
            "values": [
              "Juniper"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app closed",
        "run_id": "2026-11-01-081610",
        "checks": [
          {
            "kind": "note",
            "values": [
              "Orchid Canyon"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app open with an item",
        "run_id": "2026-11-01-081733",
        "checks": [
          {
            "kind": "note",
            "values": [
              "Canyon Summit"
            ]
          }
        ],
        "passed": true
      }
    ],
    "engine": {
      "name": "Voice Actions",
      "version": "3.9.3",
      "commit": "4918f84c9"
    }
  }
}
