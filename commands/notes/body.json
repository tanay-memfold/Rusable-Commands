{
  "id": "notes.create-note-with-text",
  "app": {
    "name": "Notes",
    "bundle_id": "com.apple.Notes",
    "version": "4.13"
  },
  "platform": {
    "os": "macOS",
    "version": "26.6.2"
  },
  "request": "make a note titled {title} with the text {text} in Notes",
  "params": [
    "title",
    "text"
  ],
  "precondition": {
    "app_frontmost": "Notes",
    "window_open": true
  },
  "steps": [
    {
      "action": "press",
      "control": {
        "role": "Button",
        "name": "New Note"
      }
    },
    {
      "action": "type",
      "control": {
        "role": "TextArea",
        "name": "note body text view"
      },
      "text": "{title}\n{text}"
    }
  ],
  "verification": {
    "status": "verified",
    "date": "2026-11-01",
    "runs": [
      {
        "start_state": "learn",
        "run_id": "2026-11-01-090136",
        "checks": [
          {
            "kind": "note",
            "values": [
              "Seed order"
            ]
          },
          {
            "kind": "body",
            "values": [
              "Seed order",
              "Call nursery"
            ]
          }
        ],
        "passed": true
      },
      {
        "start_state": "app closed",
        "run_id": "2026-11-01-090302",
