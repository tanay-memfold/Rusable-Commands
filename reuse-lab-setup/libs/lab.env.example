# Copy to lab.env (next to this file) and fill in. lab.env is git-ignored.
# SSH target for the Mac mini that runs UTM, as user@host.
MINI=user@mac-mini-host
# The test VM's address on the Mini's UTM network.
VM_IP=192.168.64.x
# The UUID of ~/rusable-lab/RusableTest.utm (Information.UUID in its config.plist).
VM_UUID=00000000-0000-0000-0000-000000000000
